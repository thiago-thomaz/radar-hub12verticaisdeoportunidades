{
  "name": "[RADAR_HUB] - 05 Multi-Channel High Velocity Alert Dispatcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "schedule-fast-poll",
      "name": "Poll Hot Deals (1m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [160, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM radar_hub.v_hot_opportunities LIMIT 10;"
      },
      "id": "db-query-hot-deals",
      "name": "Query Hot Deals from View",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [360, 300],
      "continueOnFail": true,
      "credentials": {
        "postgres": {
          "id": "CREDENTIAL_RADAR_POSTGRES",
          "name": "Postgres (radar_hub isolated)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Formatação de Mensagens Markdown de Alta Conversão\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const row = item.json;\n  if (!row.id || !row.title) continue;\n  \n  const isCritical = row.priority === 'CRITICAL_BUG';\n  const badge = isCritical ? '🚨🔥 **[BUG CRÍTICO DE PREÇO / ERRO DE SISTEMA]** 🔥🚨' : '⚡ **[SUPER OPORTUNIDADE IDENTIFICADA]** ⚡';\n  const priceDe = row.original_price ? `~~R$ ${Number(row.original_price).toFixed(2)}~~` : 'N/A';\n  const pricePor = `**R$ ${Number(row.opportunity_price).toFixed(2)}**`;\n  const discount = row.discount_percentage ? `**${Number(row.discount_percentage).toFixed(1)}% OFF**` : '';\n  const link = row.affiliate_url || row.source_url || 'https://radarhub.com';\n  \n  const message = `${badge}\n\n` +\n    `📌 **${row.title}**\n\n` +\n    `💰 **Preço:** De ${priceDe} por ${pricePor} (${discount})\n` +\n    `🎯 **Score de Arbitragem:** ${row.evaluation_score}/100\n` +\n    `📊 **Detalhe:** ${row.description || 'Oportunidade identificada pelo motor algorítmico.'}\n` +\n    `🏢 **Fonte:** ${row.source_name || 'Monitor'}\n\n` +\n    `🔗 **Acessar Agora:** [CLIQUE AQUI PARA APROVEITAR](${link})`;\n    \n  results.push({\n    json: {\n      ...row,\n      formattedTelegramMessage: message,\n      isCritical\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "code-format-message",
      "name": "Format Telegram/Discord Markdown",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 300]
    },
    {
      "parameters": {
        "chatId": "=@canal_radar_hub_alertas",
        "text": "={{ $json.formattedTelegramMessage }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "disable_web_page_preview": false
        }
      },
      "id": "telegram-send-alert",
      "name": "Send Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [780, 200],
      "continueOnFail": true,
      "credentials": {
        "telegramApi": {
          "id": "CREDENTIAL_RADAR_TELEGRAM",
          "name": "Telegram Bot (RADAR_HUB)"
        }
      }
    },
    {
      "parameters": {
        "webhookUri": "https://discord.com/api/webhooks/dummy/radar_hub",
        "text": "={{ $json.formattedTelegramMessage }}"
      },
      "id": "discord-send-alert",
      "name": "Send Discord Webhook",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [780, 400],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Poll Hot Deals (1m)": {
      "main": [
        [
          {
            "node": "Query Hot Deals from View",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Hot Deals from View": {
      "main": [
        [
          {
            "node": "Format Telegram/Discord Markdown",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Telegram/Discord Markdown": {
      "main": [
        [
          {
            "node": "Send Telegram Alert",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send Discord Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "RADAR_HUB"
    }
  ]
}
