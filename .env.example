# ==============================================================================
# RADAR_HUB - ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Modelo de referência sem credenciais reais para deploy VPS via Coolify.
# ==============================================================================

# --- AMBIENTE GERAL ---
NODE_ENV=production
PORT=3000
BASE_URL=https://radar.seu-dominio.com.br

# --- BANCO DE DADOS POSTGRESQL (COM SUPORTE A TIMESCALEDB) ---
DB_USER=radar_admin
DB_PASSWORD=your_secure_db_password_here
DB_HOST=postgres
DB_PORT=5432
DB_NAME=radar_hub_db
DATABASE_URL=postgres://radar_admin:your_secure_db_password_here@postgres:5432/radar_hub_db

# --- CACHE & QUEUES (REDIS) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379

# --- ALERTAS & DISPATCHERS MULTICANAL (100% NATIVO & INTERNALIZADO) ---
# Obter via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz_EXAMPLE
# Canal VIP de Alertas Críticos (ex: -1001234567890)
TELEGRAM_VIP_CHANNEL_ID=-1001234567890
# Canal Gratuito/Público de Amostras
TELEGRAM_FREE_CHANNEL_ID=-1009876543210
# Webhook Discord para Notificações do Cockpit Interno
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/example_token

# --- ROTATION & RESILIENT SCRAPING PROXIES ---
# Lista de Proxies formatados: protocolo://usuario:senha@ip:porta (separados por vírgula)
PROXIES_LIST=http://user:pass@proxy1.brightdata.com:22225,http://user:pass@proxy2.brightdata.com:22225

# --- CHECKOUT 1-CLIQUE & GATEWAYS ---
PIX_KEY=radar_hub_pix_chave@empresa.com.br
PIX_RECEIVER_NAME=RADAR_HUB LTDA
PIX_CITY=SAO_PAULO
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-example-token-for-checkout
STRIPE_SECRET_KEY=sk_live_example_secret_key

# --- MENSAGERIA WHATSAPP (WAHA - WHATSAPP HTTP API) ---
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=your_waha_api_key_here
WAHA_SESSION=default
WHATSAPP_VIP_GROUP_ID=120363012345678901@g.us
WHATSAPP_FREE_GROUP_ID=120363098765432109@g.us

# --- CRIPTOGRAFIA & BACKUPS S3 / R2 ---
BACKUP_STORAGE_TYPE=LOCAL
BACKUP_ENCRYPTION_KEY=your_backup_aes_256_master_key_min_32_chars!
S3_BUCKET=radar-hub-backups
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_s3_or_r2_access_key
S3_SECRET_ACCESS_KEY=your_s3_or_r2_secret_key
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
